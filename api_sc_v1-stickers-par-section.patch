 DateTime           @default(now())\n  fiche          Fiche              @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, createdAt])\n  @@index([ficheId, source, createdAt])\n  @@map(\"fiche_passages\")\n}\n\n// Modèles de carte (recto / verso) gérés par l'administration, par formule. Un seul modèle ACTIF par formule\n// (index unique partiel dans la migration card_models) : c'est celui que le client voit dans sa demande de carte.\nmodel CardModel {\n  id        Int      @id @default(autoincrement())\n  tier      PlanType\n  nom       String\n  rectoUrl  String\n  versoUrl  String\n  actif     Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([tier, actif])\n  @@map(\"card_models\")\n}\n\nenum PlanType {\n  ESSENTIELLE\n  PRO\n  SIGNATURE\n}\n\nenum Role {\n  CLIENT\n  ADMIN\n}\n\nenum SubscriptionStatus {\n  PENDING\n  ACTIVE\n  EXPIRED\n  CANCELED\n}\n\nenum PaymentProvider {\n  SIMULATION\n  WAVE\n  ORANGE_MONEY\n}\n\nenum PaymentStatus {\n  PENDING\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\nenum FichePurchaseStatus {\n  PENDING\n  CONFIRMED\n  CANCELLED\n  EXPIRED\n}\n\nenum FichePassageSource {\n  QR\n  NFC\n  DIRECT\n}\n\nenum StatutFiche {\n  ACTIVE\n  SUSPENDUE\n  BROUILLON\n}\n\nenum Secteur {\n  RESTAURANT\n  IMMOBILIER\n  COMMERCE\n  HOTEL\n  INDEPENDANT\n  BEAUTE\n}\n\nenum PremierBouton {\n  WHATSAPP\n  APPEL\n  EMAIL\n}\n\nenum Disposition {\n  PORTRAIT\n  LOGO\n  BANNIERE\n  DUO\n}\n\nenum Taille {\n  S\n  M\n  L\n}\n\nenum Theme {\n  OR\n  CLAIR\n  BLEU\n  NUIT\n}\n\nenum TabType {\n  PRESENTATION\n  MENU\n  BIENS\n  CATALOGUE\n  GALERIE\n  VIDEOS\n  LIENS\n  RENDEZVOUS\n  RAPPEL\n  HORAIRES\n  AVIS\n  RESEAUX\n  LOCALISATION\n  TEXTE\n}\n\nenum MediaType {\n  IMAGE\n  VIDEO\n}\n\nenum BienType {\n  VENTE\n  LOCATION\n}\n\nenum PrintStatus {\n  A_IMPRIMER\n  IMPRIMEE\n  ENCODEE\n  TESTEE\n  LIVREE\n  ANNULEE\n}\n\nenum StickerKind {\n  FONCTION\n  TELEPHONE\n}\n\nenum StickerFonction {\n  AVIS\n  WIFI\n  MENU\n  RESEAUX\n  CONTACT\n  RDV\n  LIEN\n}\n\nenum StickerStatus {\n  A_PARAMETRER\n  PARAMETRE\n  TESTE\n  IMPRIME\n  LIVRE\n  ANNULE\n}\n\nenum QrMode {\n  DYNAMIQUE\n  WIFI\n  FICHE\n}\n\n// Carte NFC à imprimer (Evolis, CR80) : l'adresse écrite dans la puce est figée à la création.\nmodel PrintJob {\n  id                Int         @id @default(autoincrement())\n  ficheId           Int?\n  tier              PlanType?\n  formule           String?\n  slug              String?\n  nfcUrl            String\n  design            Json?\n  rectoPath         String?\n  versoPath         String?\n  statut            PrintStatus @default(A_IMPRIMER)\n  clientNom         String?\n  clientEntreprise  String?\n  clientTelephone   String?\n  clientEmail       String?\n  clientFonction    String?\n  deliveryAddress   String?\n  deliveryTelephone String?\n  clientNotes       String?\n  amountFcfa        Int?\n  printedAt         DateTime?\n  testedAt          DateTime?\n  notes             String?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  fiche             Fiche?      @relation(fields: [ficheId], references: [id], onDelete: SetNull)\n  rectoUrl          String?\n  versoUrl          String?\n  encodedAt         DateTime?\n  deliveredAt       DateTime?\n\n  @@index([statut, createdAt])\n  @@index([ficheId])\n  @@map(\"print_jobs\")\n}\n\n// Sticker « fonction » (80/120/170 mm) ou « téléphone » (30 mm, copie du QR de la fiche).\nmodel StickerOrder {\n  id               Int              @id @default(autoincrement())\n  ficheId          Int?\n  kind             StickerKind\n  fonction         StickerFonction?\n  tailleMm         Int\n  forme            String?\n  theme            String?\n  quantite         Int              @default(1)\n  options          Json?\n  parametres       Json?\n  personnalisation Json?\n  qrMode           QrMode\n  qrCode           String?\n  ficheSlug        String?\n  statut           StickerStatus    @default(A_PARAMETRER)\n  clientNom        String?\n  clientEntreprise String?\n  clientTelephone  String?\n  clientEmail      String?\n  clientFonction   String?\n  notes            String?\n  createdAt        DateTime         @default(now())\n  updatedAt        DateTime         @updatedAt\n  fiche            Fiche?           @relation(fields: [ficheId], references: [id], onDelete: SetNull)\n  qrLinks          QrLink[]\n\n  @@index([kind, statut, createdAt])\n  @@index([qrCode])\n  @@map(\"sticker_orders\")\n}\n\n// QR dynamique : /q/<code> redirige vers une cible modifiable à distance.\nmodel QrLink {\n  code       String        @id\n  targetUrl  String?\n  label      String?\n  actif      Boolean       @default(true)\n  scans      Int           @default(0)\n  lastScanAt DateTime?\n  createdAt  DateTime      @default(now())\n  stickerId  Int?\n  sticker    StickerOrder? @relation(fields: [stickerId], references: [id], onDelete: SetNull)\n\n  @@index([stickerId])\n  @@map(\"qr_links\")\n}\n\n// Remise selon la durée d'engagement (1 mois 0 %, 3 mois 10 %, 6 mois 15 %, 12 mois 20 %).\nmodel PlanDuree {\n  id        Int  @id @default(autoincrement())\n  planId    Int\n  dureeMois Int\n  remisePct Int\n  plan      Plan @relation(fields: [planId], references: [id], onDelete: Cascade)\n\n  @@unique([planId, dureeMois])\n  @@map(\"plan_durees\")\n}\n\n// Remise selon le nombre de fiches prises d'un coup : à partir de `quantiteMin`, `remisePct` %.\nmodel PlanRemise {\n  id          Int  @id @default(autoincrement())\n  planId      Int\n  quantiteMin Int\n  remisePct   Int\n  plan        Plan @relation(fields: [planId], references: [id], onDelete: Cascade)\n\n  @@unique([planId, quantiteMin])\n  @@map(\"plan_remises\")\n}\n\n// Emplacements de fiches gratuites supplémentaires : une seule ligne (id = 1).\nmodel EmplacementConfig {\n  id               Int  @id @default(1)\n  prixUnitaireFcfa Int?\n  fichesGratuites  Int  @default(3)\n\n  @@map(\"emplacement_config\")\n}\n\n// Packs d'emplacements à prix fixe (ex. 3 emplacements pour 3 500 FCFA).\nmodel EmplacementPack {\n  id       Int @id @default(autoincrement())\n  quantite Int @unique\n  prixFcfa Int\n\n  @@map(\"emplacement_packs\")\n}\n\nmodel QrStyle {\n  id        Int      @id @default(autoincrement())\n  userId    Int      @map(\"user_id\")\n  nom       String\n  style     Json\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@map(\"qr_styles\")\n}\n\nmodel LeadRequest {\n  id               Int        @id @default(autoincrement())\n  intent           String\n  intentLabel      String\n  products         String[]   @default([])\n  sector           String?\n  name             String\n  role             String?\n  company          String?\n  phone            String?\n  email            String?\n  city             String?\n  prefer           String?\n  message          String?\n  consentMarketing Boolean    @default(false)\n  consentText      String?\n  consentAt        DateTime?\n  source           String     @default(\"site\")\n  page             String?\n  pole             String?\n  services         String[]   @default([])\n  production       String?\n  delai            String?\n  profil           String?\n  projet           Json?\n  design           Json?\n  status           LeadStatus @default(NEW)\n  createdAt        DateTime   @default(now())\n  updatedAt        DateTime   @updatedAt\n\n  @@index([status, createdAt])\n  @@index([createdAt])\n  @@map(\"lead_requests\")\n}\n\nenum LeadStatus {\n  NEW\n  CONTACTED\n  CLOSED\n}\n",
+  "inlineSchema": "generator client {\n  provider = \"prisma-client\"\n  output   = \"generated/prisma\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n}\n\nmodel Fiche {\n  id                Int                     @id @default(autoincrement())\n  slug              String                  @unique\n  prenom            String\n  nom               String                  @default(\"\")\n  fonction          String?\n  entreprise        String?\n  photo             String?\n  logo              String?\n  telephone         String?\n  whatsapp          String?\n  email             String?\n  site              String?\n  adresse           String?\n  googlePlaceId     String?\n  premierBouton     PremierBouton           @default(WHATSAPP)\n  messageWhatsapp   String?\n  statut            StatutFiche             @default(BROUILLON)\n  enLigneSeule      Boolean                 @default(false)\n  scansTotal        Int                     @default(0)\n  userId            Int?\n  secteur           Secteur?\n  presentation      String?\n  rdvLabel          String?\n  rdvUrl            String?\n  enteteDisposition Disposition             @default(PORTRAIT)\n  enteteTaille      Taille                  @default(M)\n  enteteTheme       Theme?\n  enteteCouverture  String?\n  createdAt         DateTime                @default(now())\n  updatedAt         DateTime                @updatedAt\n  biens             Bien[]\n  catalogueSections CatalogueSection[]\n  horaires          FicheHoraire[]\n  liens             FicheLien[]\n  medias            FicheMedia[]\n  onglets           FicheOnglet[]\n  reseaux           FicheReseau[]\n  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)\n  menuSections      MenuSection[]\n  printJobs         PrintJob[]\n  stickers          StickerOrder[]\n  sectionStickers   SectionStickerRequest[]\n  subscriptions     Subscription[]\n  payments          Payment[]\n  passages          FichePassage[]\n  demandeRappels    DemandeRappel[]\n\n  @@index([userId])\n  @@index([statut])\n  @@map(\"fiches\")\n}\n\nmodel FicheOnglet {\n  id       String  @id @default(cuid())\n  ficheId  Int\n  type     TabType\n  titre    String?\n  contenu  String?\n  visible  Boolean @default(true)\n  position Int\n  fiche    Fiche   @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, position])\n  @@map(\"fiche_onglets\")\n}\n\nmodel FicheReseau {\n  id       Int    @id @default(autoincrement())\n  ficheId  Int\n  label    String\n  url      String\n  position Int    @default(0)\n  fiche    Fiche  @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId])\n  @@map(\"fiche_reseaux\")\n}\n\nmodel FicheLien {\n  id       Int    @id @default(autoincrement())\n  ficheId  Int\n  label    String\n  url      String\n  position Int    @default(0)\n  fiche    Fiche  @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId])\n  @@map(\"fiche_liens\")\n}\n\nmodel FicheHoraire {\n  id      Int    @id @default(autoincrement())\n  ficheId Int\n  jour    Int\n  horaire String\n  fiche   Fiche  @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@unique([ficheId, jour])\n  @@map(\"fiche_horaires\")\n}\n\nmodel FicheMedia {\n  id       Int       @id @default(autoincrement())\n  ficheId  Int\n  type     MediaType @default(IMAGE)\n  url      String\n  alt      String?\n  position Int       @default(0)\n  fiche    Fiche     @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, position])\n  @@map(\"fiche_medias\")\n}\n\nmodel CatalogueSection {\n  id       Int                @id @default(autoincrement())\n  ficheId  Int\n  titre    String\n  position Int                @default(0)\n  articles CatalogueArticle[]\n  fiche    Fiche              @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, position])\n  @@map(\"catalogue_sections\")\n}\n\nmodel CatalogueArticle {\n  id          Int              @id @default(autoincrement())\n  sectionId   Int\n  nom         String\n  description String?\n  photo       String?\n  prix        Int?\n  badge       String?\n  position    Int              @default(0)\n  section     CatalogueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n\n  @@index([sectionId, position])\n  @@map(\"catalogue_articles\")\n}\n\nmodel MenuSection {\n  id       Int        @id @default(autoincrement())\n  ficheId  Int\n  titre    String\n  position Int        @default(0)\n  plats    MenuPlat[]\n  fiche    Fiche      @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, position])\n  @@map(\"menu_sections\")\n}\n\nmodel MenuPlat {\n  id          Int         @id @default(autoincrement())\n  sectionId   Int\n  nom         String\n  prix        Int?\n  description String?\n  image       String?\n  video       String?\n  videoWebm   String?\n  badge       String?\n  position    Int         @default(0)\n  section     MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n\n  @@index([sectionId, position])\n  @@map(\"menu_plats\")\n}\n\nmodel Bien {\n  id          Int         @id @default(autoincrement())\n  ficheId     Int\n  titre       String\n  type        BienType\n  prix        Int?\n  periode     String?\n  ville       String?\n  surface     Int?\n  terrain     Int?\n  chambres    Int?\n  sdb         Int?\n  atouts      String[]\n  description String?\n  position    Int         @default(0)\n  photos      BienPhoto[]\n  fiche       Fiche       @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, position])\n  @@map(\"biens\")\n}\n\nmodel BienPhoto {\n  id       Int    @id @default(autoincrement())\n  bienId   Int\n  url      String\n  position Int    @default(0)\n  bien     Bien   @relation(fields: [bienId], references: [id], onDelete: Cascade)\n\n  @@index([bienId, position])\n  @@map(\"bien_photos\")\n}\n\nmodel User {\n  id              Int                     @id @default(autoincrement())\n  email           String                  @unique\n  passwordHash    String\n  role            Role                    @default(CLIENT)\n  nom             String?\n  emailVerifiedAt DateTime?\n  createdAt       DateTime                @default(now())\n  tokens          AuthToken[]\n  fiches          Fiche[]\n  sectionStickers SectionStickerRequest[]\n  qrStyles        QrStyle[]\n  fichePurchases  FichePurchase[]\n\n  @@map(\"users\")\n}\n\nmodel AuthToken {\n  id        Int       @id @default(autoincrement())\n  userId    Int\n  type      String\n  tokenHash String    @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@map(\"auth_tokens\")\n}\n\nmodel Plan {\n  id              Int             @id @default(autoincrement())\n  type            PlanType        @unique\n  nom             String\n  themeDefaut     Theme\n  prixMensuelFcfa Int?\n  prixFcfa        Int?\n  dureeMois       Int?\n  actif           Boolean         @default(true)\n  limits          PlanLimit?\n  subscriptions   Subscription[]\n  payments        Payment[]\n  purchases       FichePurchase[]\n  durees          PlanDuree[]\n  remises         PlanRemise[]\n\n  @@map(\"plans\")\n}\n\nmodel PlanLimit {\n  planId                       Int           @id\n  tabsAutorises                TabType[]\n  headerLayouts                Disposition[]\n  themes                       Theme[]\n  canReorder                   Boolean       @default(false)\n  canHide                      Boolean       @default(false)\n  canAdd                       Boolean       @default(false)\n  canRename                    Boolean       @default(false)\n  maxCustomTabs                Int           @default(0)\n  maxPresentation              Int\n  maxSocial                    Int\n  maxLinks                     Int\n  maxPhotos                    Int\n  maxVideos                    Int\n  maxCatalogSections           Int           @default(0)\n  maxCatalogArticlesPerSection Int           @default(0)\n  catalogPrices                Boolean       @default(false)\n  maxMenuSections              Int           @default(0)\n  maxMenuItemsPerSection       Int           @default(0)\n  menuVideoPerItem             Boolean       @default(false)\n  maxMenuVideoSeconds          Int           @default(0)\n  maxBiens                     Int           @default(0)\n  maxPhotosPerBien             Int           @default(0)\n  hasCatalog                   Boolean       @default(false)\n  hasMenu                      Boolean       @default(false)\n  hasBiens                     Boolean       @default(false)\n  hasGoogleReview              Boolean       @default(false)\n  hasStats                     Boolean       @default(false)\n  hasForm                      Boolean       @default(false)\n  hasDashboard                 Boolean       @default(false)\n  plan                         Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)\n\n  @@map(\"plan_limits\")\n}\n\nmodel Subscription {\n  id         Int                @id @default(autoincrement())\n  ficheId    Int?\n  planId     Int\n  status     SubscriptionStatus @default(ACTIVE)\n  startsAt   DateTime           @default(now())\n  endsAt     DateTime?\n  canceledAt DateTime?\n  amountFcfa Int?\n  paymentRef String?\n  createdAt  DateTime           @default(now())\n  fiche      Fiche?             @relation(fields: [ficheId], references: [id], onDelete: SetNull)\n  plan       Plan               @relation(fields: [planId], references: [id])\n\n  ficheNomSnapshot  String?\n  ficheSlugSnapshot String?   @default(\"valeur-par-defaut\")\n  payments          Payment[]\n\n  @@index([ficheId, status])\n  @@index([endsAt])\n  @@map(\"subscriptions\")\n}\n\nmodel Payment {\n  id                Int             @id @default(autoincrement())\n  ficheId           Int?\n  subscriptionId    Int?\n  planId            Int\n  dureeMois         Int?\n  provider          PaymentProvider @default(SIMULATION)\n  status            PaymentStatus   @default(PENDING)\n  amountFcfa        Int\n  currency          String          @default(\"XOF\")\n  providerReference String?         @unique\n  failureReason     String?\n  paidAt            DateTime?\n  createdAt         DateTime        @default(now())\n  updatedAt         DateTime        @updatedAt\n  fiche             Fiche?          @relation(fields: [ficheId], references: [id], onDelete: SetNull)\n  plan              Plan            @relation(fields: [planId], references: [id])\n  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)\n\n  ficheNomSnapshot  String?\n  ficheSlugSnapshot String? @default(\"valeur-par-defaut\")\n\n  @@index([ficheId, status, createdAt])\n  @@map(\"payments\")\n}\n\nmodel FichePurchase {\n  id           Int                 @id @default(autoincrement())\n  userId       Int\n  planId       Int\n  quantity     Int\n  freeQuantity Int                 @default(0)\n  dureeMois    Int?\n  amountFcfa   Int\n  status       FichePurchaseStatus @default(PENDING)\n  reference    String              @unique\n  expiresAt    DateTime\n  createdAt    DateTime            @default(now())\n  confirmedAt  DateTime?\n  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)\n  plan         Plan                @relation(fields: [planId], references: [id])\n\n  @@index([userId, status, expiresAt])\n  @@map(\"fiche_purchases\")\n}\n\n// Demande de rappel envoyée depuis la fiche publique (onglet RAPPEL).\nmodel DemandeRappel {\n  id        Int      @id @default(autoincrement())\n  ficheId   Int\n  nom       String\n  telephone String\n  createdAt DateTime @default(now())\n  fiche     Fiche    @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, createdAt])\n}\n\n// Événement individuel d'ouverture publique d'une fiche (QR, NFC ou lien direct).\nmodel FichePassage {\n  id             Int                @id @default(autoincrement())\n  ficheId        Int\n  source         FichePassageSource\n  idempotencyKey String             @unique @db.VarChar(64)\n  createdAt      DateTime           @default(now())\n  fiche          Fiche              @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n\n  @@index([ficheId, createdAt])\n  @@index([ficheId, source, createdAt])\n  @@map(\"fiche_passages\")\n}\n\n// Modèles de carte (recto / verso) gérés par l'administration, par formule. Un seul modèle ACTIF par formule\n// (index unique partiel dans la migration card_models) : c'est celui que le client voit dans sa demande de carte.\nmodel CardModel {\n  id        Int      @id @default(autoincrement())\n  tier      PlanType\n  nom       String\n  rectoUrl  String\n  versoUrl  String\n  actif     Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([tier, actif])\n  @@map(\"card_models\")\n}\n\nenum PlanType {\n  ESSENTIELLE\n  PRO\n  SIGNATURE\n}\n\nenum Role {\n  CLIENT\n  ADMIN\n}\n\nenum SubscriptionStatus {\n  PENDING\n  ACTIVE\n  EXPIRED\n  CANCELED\n}\n\nenum PaymentProvider {\n  SIMULATION\n  WAVE\n  ORANGE_MONEY\n}\n\nenum PaymentStatus {\n  PENDING\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\nenum FichePurchaseStatus {\n  PENDING\n  CONFIRMED\n  CANCELLED\n  EXPIRED\n}\n\nenum FichePassageSource {\n  QR\n  NFC\n  DIRECT\n}\n\nenum StatutFiche {\n  ACTIVE\n  SUSPENDUE\n  BROUILLON\n}\n\nenum Secteur {\n  RESTAURANT\n  IMMOBILIER\n  COMMERCE\n  HOTEL\n  INDEPENDANT\n  BEAUTE\n}\n\nenum PremierBouton {\n  WHATSAPP\n  APPEL\n  EMAIL\n}\n\nenum Disposition {\n  PORTRAIT\n  LOGO\n  BANNIERE\n  DUO\n}\n\nenum Taille {\n  S\n  M\n  L\n}\n\nenum Theme {\n  OR\n  CLAIR\n  BLEU\n  NUIT\n}\n\nenum TabType {\n  PRESENTATION\n  MENU\n  BIENS\n  CATALOGUE\n  GALERIE\n  VIDEOS\n  LIENS\n  RENDEZVOUS\n  RAPPEL\n  HORAIRES\n  AVIS\n  RESEAUX\n  LOCALISATION\n  TEXTE\n}\n\nenum MediaType {\n  IMAGE\n  VIDEO\n}\n\nenum BienType {\n  VENTE\n  LOCATION\n}\n\nenum PrintStatus {\n  A_IMPRIMER\n  IMPRIMEE\n  ENCODEE\n  TESTEE\n  LIVREE\n  ANNULEE\n}\n\nenum StickerKind {\n  FONCTION\n  TELEPHONE\n}\n\nenum StickerFonction {\n  AVIS\n  WIFI\n  MENU\n  RESEAUX\n  CONTACT\n  RDV\n  LIEN\n}\n\nenum StickerStatus {\n  A_PARAMETRER\n  PARAMETRE\n  TESTE\n  IMPRIME\n  LIVRE\n  ANNULE\n}\n\nenum QrMode {\n  DYNAMIQUE\n  WIFI\n  FICHE\n}\n\n// Carte NFC à imprimer (Evolis, CR80) : l'adresse écrite dans la puce est figée à la création.\nmodel PrintJob {\n  id                Int         @id @default(autoincrement())\n  ficheId           Int?\n  tier              PlanType?\n  formule           String?\n  slug              String?\n  nfcUrl            String\n  design            Json?\n  rectoPath         String?\n  versoPath         String?\n  statut            PrintStatus @default(A_IMPRIMER)\n  clientNom         String?\n  clientEntreprise  String?\n  clientTelephone   String?\n  clientEmail       String?\n  clientFonction    String?\n  deliveryAddress   String?\n  deliveryTelephone String?\n  clientNotes       String?\n  amountFcfa        Int?\n  printedAt         DateTime?\n  testedAt          DateTime?\n  notes             String?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  fiche             Fiche?      @relation(fields: [ficheId], references: [id], onDelete: SetNull)\n  rectoUrl          String?\n  versoUrl          String?\n  encodedAt         DateTime?\n  deliveredAt       DateTime?\n\n  @@index([statut, createdAt])\n  @@index([ficheId])\n  @@map(\"print_jobs\")\n}\n\n// Sticker « fonction » (80/120/170 mm) ou « téléphone » (30 mm, copie du QR de la fiche).\nmodel StickerOrder {\n  id               Int              @id @default(autoincrement())\n  ficheId          Int?\n  kind             StickerKind\n  fonction         StickerFonction?\n  tailleMm         Int\n  forme            String?\n  theme            String?\n  quantite         Int              @default(1)\n  options          Json?\n  parametres       Json?\n  personnalisation Json?\n  qrMode           QrMode\n  qrCode           String?\n  ficheSlug        String?\n  statut           StickerStatus    @default(A_PARAMETRER)\n  clientNom        String?\n  clientEntreprise String?\n  clientTelephone  String?\n  clientEmail      String?\n  clientFonction   String?\n  notes            String?\n  createdAt        DateTime         @default(now())\n  updatedAt        DateTime         @updatedAt\n  fiche            Fiche?           @relation(fields: [ficheId], references: [id], onDelete: SetNull)\n  qrLinks          QrLink[]\n\n  @@index([kind, statut, createdAt])\n  @@index([qrCode])\n  @@map(\"sticker_orders\")\n}\n\n// Demande de stickers « par section » : le client demande un devis (nombre de stickers) pour qu'un QR ouvre UNE section de\n// sa fiche. Tant que l'administration ne l'a pas ACTIVÉE, la section n'est pas servie en page /s/:slug/:section.\n// Une seule demande « ouverte » (DEMANDE ou ACTIVE) par fiche et par section : index unique partiel dans la migration.\nenum SectionStickerStatus {\n  DEMANDE\n  ACTIVE\n  DESACTIVEE\n  REFUSEE\n}\n\nmodel SectionStickerRequest {\n  id          Int                  @id @default(autoincrement())\n  ficheId     Int\n  userId      Int?\n  // Clé de la section dans l'URL : type d'onglet (menu, biens…) ou identifiant d'un onglet personnalisé.\n  section     String\n  quantite    Int\n  message     String?\n  statut      SectionStickerStatus @default(DEMANDE)\n  activatedAt DateTime?\n  createdAt   DateTime             @default(now())\n  updatedAt   DateTime             @updatedAt\n  fiche       Fiche                @relation(fields: [ficheId], references: [id], onDelete: Cascade)\n  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  @@index([ficheId, section])\n  @@index([statut, createdAt])\n  @@map(\"section_sticker_requests\")\n}\n\n// QR dynamique : /q/<code> redirige vers une cible modifiable à distance.\nmodel QrLink {\n  code       String        @id\n  targetUrl  String?\n  label      String?\n  actif      Boolean       @default(true)\n  scans      Int           @default(0)\n  lastScanAt DateTime?\n  createdAt  DateTime      @default(now())\n  stickerId  Int?\n  sticker    StickerOrder? @relation(fields: [stickerId], references: [id], onDelete: SetNull)\n\n  @@index([stickerId])\n  @@map(\"qr_links\")\n}\n\n// Remise selon la durée d'engagement (1 mois 0 %, 3 mois 10 %, 6 mois 15 %, 12 mois 20 %).\nmodel PlanDuree {\n  id        Int  @id @default(autoincrement())\n  planId    Int\n  dureeMois Int\n  remisePct Int\n  plan      Plan @relation(fields: [planId], references: [id], onDelete: Cascade)\n\n  @@unique([planId, dureeMois])\n  @@map(\"plan_durees\")\n}\n\n// Remise selon le nombre de fiches prises d'un coup : à partir de `quantiteMin`, `remisePct` %.\nmodel PlanRemise {\n  id          Int  @id @default(autoincrement())\n  planId      Int\n  quantiteMin Int\n  remisePct   Int\n  plan        Plan @relation(fields: [planId], references: [id], onDelete: Cascade)\n\n  @@unique([planId, quantiteMin])\n  @@map(\"plan_remises\")\n}\n\n// Emplacements de fiches gratuites supplémentaires : une seule ligne (id = 1).\nmodel EmplacementConfig {\n  id               Int  @id @default(1)\n  prixUnitaireFcfa Int?\n  fichesGratuites  Int  @default(3)\n\n  @@map(\"emplacement_config\")\n}\n\n// Packs d'emplacements à prix fixe (ex. 3 emplacements pour 3 500 FCFA).\nmodel EmplacementPack {\n  id       Int @id @default(autoincrement())\n  quantite Int @unique\n  prixFcfa Int\n\n  @@map(\"emplacement_packs\")\n}\n\nmodel QrStyle {\n  id        Int      @id @default(autoincrement())\n  userId    Int      @map(\"user_id\")\n  nom       String\n  style     Json\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@map(\"qr_styles\")\n}\n\nmodel LeadRequest {\n  id               Int        @id @default(autoincrement())\n  intent           String\n  intentLabel      String\n  products         String[]   @default([])\n  sector           String?\n  name             String\n  role             String?\n  company          String?\n  phone            String?\n  email            String?\n  city             String?\n  prefer           String?\n  message          String?\n  consentMarketing Boolean    @default(false)\n  consentText      String?\n  consentAt        DateTime?\n  source           String     @default(\"site\")\n  page             String?\n  pole             String?\n  services         String[]   @default([])\n  production       String?\n  delai            String?\n  profil           String?\n  projet           Json?\n  design           Json?\n  status           LeadStatus @default(NEW)\n  createdAt        DateTime   @default(now())\n  updatedAt        DateTime   @updatedAt\n\n  @@index([status, createdAt])\n  @@index([createdAt])\n  @@map(\"lead_requests\")\n}\n\nenum LeadStatus {\n  NEW\n  CONTACTED\n  CLOSED\n}\n",
