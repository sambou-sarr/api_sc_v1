    {
      "name": "6 - Nettoyage",
      "item": [
        {
          "name": "Supprimer la fiche de test (avec confirmation)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches/{{ficheId}}?confirmer={{ficheSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches",
                "{{ficheId}}"
              ],
              "query": [
                {
                  "key": "confirmer",
                  "value": "{{ficheSlug}}"
                }
              ]
            },
            "description": "Définitif. ficheSlug est rempli par la requête de création (si tu as changé le slug, mets le nouveau)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 supprimée', () => pm.response.to.have.status(200));"
