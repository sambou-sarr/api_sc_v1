              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 introuvable', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Slug invalide -> 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches/{{ficheId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches",
                "{{ficheId}}"
