    {
      "name": "5 - Cas d'erreur (doivent échouer)",
      "item": [
        {
          "name": "Sans token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 non authentifié', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "page=0 -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches?page=0",
              "host": [
                "{{baseUrl}}"
              ],
