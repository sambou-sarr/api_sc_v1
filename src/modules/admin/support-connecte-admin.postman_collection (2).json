{
  "info": {
    "name": "Support Connecté - Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tests du module admin. Ordre conseillé : 0, 1, 2, 3, 4, 5, 6. Renseigne adminEmail et adminPassword dans les variables de la collection."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "adminEmail",
      "value": "toi@test.sn"
    },
    {
      "key": "adminPassword",
      "value": "MotDePasse123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ficheId",
      "value": ""
    },
    {
      "key": "ficheSlug",
      "value": ""
    },
    {
      "key": "subId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Connexion",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Enregistre le token dans la variable de collection {{token}}. Le compte doit avoir le rôle ADMIN (UPDATE users SET role='ADMIN' ...)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Connexion réussie', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Tableau de bord",
      "item": [
        {
          "name": "Statistiques",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Fiches",
      "item": [
        {
          "name": "Créer une fiche (formule pro, sans propriétaire)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prenom\": \"Awa\",\n  \"nom\": \"Ndiaye\",\n  \"entreprise\": \"Studio Awa\",\n  \"secteur\": \"beaute\",\n  \"telephone\": \"+221 76 190 14 64\",\n  \"formule\": \"pro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sans userId : un claimCode est généré pour la carte. Enregistre ficheId et ficheSlug."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fiche créée (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('ficheId', json.fiche.id);",
                  "pm.collectionVariables.set('ficheSlug', json.fiche.slug);"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste (sans filtre)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste filtrée (recherche + formule + tri)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches?search=awa&formule=pro&tri=scans&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "awa"
                },
                {
                  "key": "formule",
                  "value": "pro"
                },
                {
                  "key": "tri",
                  "value": "scans"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
