            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 confirmation invalide', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
