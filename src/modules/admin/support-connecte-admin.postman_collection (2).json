    {
      "name": "3 - Abonnements",
      "item": [
        {
          "name": "Activer la formule Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches/{{ficheId}}/subscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches",
                "{{ficheId}}",
                "subscription"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"signature\",\n  \"amountFcfa\": 225000,\n  \"paymentRef\": \"WAVE-TEST-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Abonnement activé (201)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('subId', pm.response.json().subscription.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Annuler cet abonnement",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches/{{ficheId}}/subscriptions/{{subId}}/cancel",
              "host": [
