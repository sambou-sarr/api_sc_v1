            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"Slug Invalide!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 slug invalide', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suppression sans bonne confirmation -> 422",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/fiches/{{ficheId}}?confirmer=mauvais-slug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "fiches",
                "{{ficheId}}"
              ],
              "query": [
